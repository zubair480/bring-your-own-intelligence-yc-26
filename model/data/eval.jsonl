{"id": "eval-001", "component": {"type": "ia.symbol.pump", "name": "FeedPump-P-102"}, "instruction": "Operators want a green pump symbol whenever it is on.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"runFill": "#4A4A48"}, "target": "{\"runFill\": \"#4A4A48\"}"}
{"id": "eval-002", "component": {"type": "ia.symbol.pump", "name": "Sym_P101"}, "instruction": "Paint the run state #00FF00 please.", "rules": ["Plant HMI standard", "Bind only to existing tags"], "patch": {"runFill": "#4A4A48"}, "target": "{\"runFill\": \"#4A4A48\"}"}
{"id": "eval-003", "component": {"type": "ia.symbol.pump", "name": "Sym_P102"}, "instruction": "When this thing trips I want it to scream at the operator.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"faultColor": "#E0301E"}, "target": "{\"faultColor\": \"#E0301E\"}"}
{"id": "eval-004", "component": {"type": "ia.symbol.pump", "name": "FeedPump-P-102"}, "instruction": "Operators need to see how fast it's spinning.", "rules": ["House ISA-101 rules apply"], "patch": {"showSpeed": true}, "target": "{\"showSpeed\": true}"}
{"id": "eval-005", "component": {"type": "ia.symbol.pump", "name": "Sym_P103"}, "instruction": "Swap the run caption to 'RUNNING' and tint it green.", "rules": ["House ISA-101 rules apply"], "patch": {"runLabel": "RUNNING", "runFill": "#4A4A48"}, "target": "{\"runLabel\": \"RUNNING\", \"runFill\": \"#4A4A48\"}"}
{"id": "eval-006", "component": {"type": "ia.symbol.pump", "name": "Sym_P102"}, "instruction": "Everything on: rpm percent, current draw, and a green running state.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"runFill": "#4A4A48", "showSpeed": true, "showAmps": true}, "target": "{\"runFill\": \"#4A4A48\", \"showSpeed\": true, \"showAmps\": true}"}
{"id": "eval-007", "component": {"type": "ia.display.cylindricaltank", "name": "Vessel T-102"}, "instruction": "This gauge isn't connected to anything, fix the binding.", "rules": ["House ISA-101 rules apply"], "patch": {"tag": "[default]Station01/T-102/LevelPct"}, "target": "{\"tag\": \"[default]Station01/T-102/LevelPct\"}"}
{"id": "eval-008", "component": {"type": "ia.display.cylindricaltank", "name": "Vessel T-102"}, "instruction": "Operators should see where the overflow and dry-run setpoints sit.", "rules": ["Plant HMI standard", "Bind only to existing tags"], "patch": {"showLimits": true, "hi": "[default]Station01/T-102/LevelHi", "lo": "[default]Station01/T-102/LevelLo"}, "target": "{\"showLimits\": true, \"hi\": \"[default]Station01/T-102/LevelHi\", \"lo\": \"[default]Station01/T-102/LevelLo\"}"}
{"id": "eval-009", "component": {"type": "ia.display.cylindricaltank", "name": "T101_Gauge"}, "instruction": "Connect it to live level and mark the high and low trips.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"tag": "[default]Station01/T-101/LevelPct", "showLimits": true, "hi": "[default]Station01/T-101/LevelHi", "lo": "[default]Station01/T-101/LevelLo"}, "target": "{\"tag\": \"[default]Station01/T-101/LevelPct\", \"showLimits\": true, \"hi\": \"[default]Station01/T-101/LevelHi\", \"lo\": \"[default]Station01/T-101/LevelLo\"}"}
{"id": "eval-010", "component": {"type": "ia.display.alarmstatustable", "name": "AlmSummary"}, "instruction": "Too noisy, I only care about critical priority or worse.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"minPriority": "Critical"}, "target": "{\"minPriority\": \"Critical\"}"}
{"id": "eval-011", "component": {"type": "ia.display.alarmstatustable", "name": "ActiveAlarms"}, "instruction": "Just medium and up, plus a bulk acknowledge.", "rules": ["House ISA-101 rules apply"], "patch": {"minPriority": "Medium", "showAckAll": true}, "target": "{\"minPriority\": \"Medium\", \"showAckAll\": true}"}
{"id": "eval-012", "component": {"type": "ia.chart.timeseries", "name": "HistoryPlot"}, "instruction": "Zoom out so I can see the whole 12 hours.", "rules": ["House ISA-101 rules apply"], "patch": {"rangeMinutes": 720}, "target": "{\"rangeMinutes\": 720}"}
{"id": "eval-013", "component": {"type": "ia.chart.timeseries", "name": "Overview Trend"}, "instruction": "Overlay P-101's motor current with its own scale.", "rules": ["House ISA-101 rules apply"], "patch": {"secondAxis": {"tag": "[default]Station01/P-101/Amps", "units": "A"}}, "target": "{\"secondAxis\": {\"tag\": \"[default]Station01/P-101/Amps\", \"units\": \"A\"}}"}
{"id": "eval-014", "component": {"type": "ia.display.label", "name": "P-103 Amps Readout"}, "instruction": "Nobody knows what this number means, clarify it.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"units": "A"}, "target": "{\"units\": \"A\"}"}
{"id": "eval-015", "component": {"type": "ia.display.label", "name": "P-102 Amps Readout"}, "instruction": "Give me an amber heads-up once it passes 30.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"units": "A", "warnAbove": {"value": 30, "units": "A", "color": "#F5A623"}}, "target": "{\"units\": \"A\", \"warnAbove\": {\"value\": 30, \"units\": \"A\", \"color\": \"#F5A623\"}}"}
{"id": "eval-016", "component": {"type": "ia.display.label", "name": "T-102 LevelPct Readout"}, "instruction": "Visualize it with a little fill bar too.", "rules": ["House ISA-101 rules apply"], "patch": {"units": "%", "showBar": true}, "target": "{\"units\": \"%\", \"showBar\": true}"}
{"id": "eval-017", "component": {"type": "ia.symbol.valve", "name": "V202_Symbol"}, "instruction": "How far open is it? Show that.", "rules": ["Plant HMI standard", "Bind only to existing tags"], "patch": {"showOpenPct": true}, "target": "{\"showOpenPct\": true}"}
{"id": "eval-018", "component": {"type": "ia.symbol.valve", "name": "Ctrl Valve V-201"}, "instruction": "Open should read as green, and add its position.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"showOpenPct": true}, "target": "{\"showOpenPct\": true}"}
{"id": "eval-019", "component": {"type": "ia.symbol.sensor", "name": "Meter FT301"}, "instruction": "I want the running total of what's gone through.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"showTotal": true}, "target": "{\"showTotal\": true}"}
{"id": "eval-020", "component": {"type": "ia.symbol.sensor", "name": "Meter FT301"}, "instruction": "Heads-up if flow sags under 25.", "rules": ["Station01 display conventions", "Always show engineering units"], "patch": {"warnBelow": {"value": 25, "units": "GPM", "color": "#F5A623"}}, "target": "{\"warnBelow\": {\"value\": 25, \"units\": \"GPM\", \"color\": \"#F5A623\"}}"}
